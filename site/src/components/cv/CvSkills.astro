---
import { cvData } from '../../data/cv';
---
<section class="cv-skills" data-cv-reveal aria-labelledby="cv-skills-heading">
	<h2 id="cv-skills-heading">Skills</h2>
	<ul>
		{cvData.skills.map((skill) => (
			<li>{skill}</li>
		))}
	</ul>
</section>

<style>
	.cv-skills {
		margin: 3.125rem 0 0;
		max-width: 100%;
	}
	.cv-skills h2 {
		font-size: 44px;
		font-weight: normal;
		width: 100%;
		border-bottom: 1px solid #b7c8cb;
		text-transform: uppercase;
		padding-bottom: 0.3125rem;
		margin: 0 0 1rem;
		line-height: 1.1;
	}
	.cv-skills ul {
		padding: 2.5rem 0;
		margin: 0;
		list-style: disc;
		padding-left: 1.5rem;
	}
	.cv-skills li {
		letter-spacing: 1px;
		font-size: 18px;
		margin-bottom: 1rem;
		line-height: 1.4;
	}
</style>
