---
import { cvData } from '../../data/cv';

const typewriterText = cvData.summary.join(' ');
---
<section
	class="cv-summary"
	data-cv-typewriter
	data-cv-typewriter-text={typewriterText}
	aria-labelledby="cv-summary-heading"
>
	<h2 id="cv-summary-heading" class="visually-hidden">Summary</h2>
	<p>
		<span data-cv-typewriter-text></span><span class="cv-summary__cursor" aria-hidden="true">|</span>
	</p>
</section>

<style>
	.cv-summary {
		margin: 2.5rem 0;
		max-width: 100%;
	}
	.cv-summary p {
		margin: 0 0 0.625rem;
		line-height: 1.4;
		font-size: 18px;
		letter-spacing: 1px;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
