---
import { cvData } from '../../data/cv';
---
<section class="cv-summary" aria-labelledby="cv-summary-heading">
	<h2 id="cv-summary-heading" class="visually-hidden">Summary</h2>
	{cvData.summary.map((paragraph) => (
		<p>{paragraph}</p>
	))}
</section>

<style>
	.cv-summary {
		margin: 2.5rem 0;
		max-width: 100%;
	}
	.cv-summary p {
		margin: 0 0 0.625rem;
		line-height: 1.4;
		font-size: 1.125rem;
		letter-spacing: 1px;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
