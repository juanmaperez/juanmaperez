---
import { cvData } from '../../data/cv';
---
<section class="cv-education" data-cv-reveal aria-labelledby="cv-education-heading">
	<h2 id="cv-education-heading">Education</h2>
	{cvData.education.map((entry) => (
		<article class="cv-education__item">
			<p class="cv-education__title">
				<strong>{entry.title}</strong> | <span>{entry.institution}</span>
			</p>
			<p class="cv-education__details">{entry.details}</p>
		</article>
	))}
</section>

<style>
	.cv-education {
		margin: 2.5rem 0;
		max-width: 100%;
	}
	.cv-education h2 {
		font-size: 44px;
		font-weight: normal;
		width: 100%;
		border-bottom: 1px solid #b7c8cb;
		text-transform: uppercase;
		padding-bottom: 0.3125rem;
		margin: 0 0 1rem;
		line-height: 1.1;
	}
	.cv-education__item {
		margin: 2.5rem 0;
	}
	.cv-education__title {
		line-height: 1.4;
		font-size: 22px;
		letter-spacing: 1px;
		margin: 0;
	}
	.cv-education__title strong {
		color: #000;
	}
	.cv-education__title span {
		color: #b7c8cb;
	}
	.cv-education__details {
		margin: 1.25rem 0 0;
		font-size: 18px;
		letter-spacing: 1px;
		line-height: 1.4;
	}
</style>
