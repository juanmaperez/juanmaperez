---
// site/src/components/home/HomeContact.astro
import { siteConfig } from '../../site.config';

const mailto = `mailto:${siteConfig.contact.email}`;
---
<section class="home-contact block-contact" data-home-contact aria-labelledby="home-contact-heading">
	<h2 id="home-contact-heading" class="visually-hidden">Contact</h2>
	<div class="home-contact__cover cover" data-home-contact-cover aria-hidden="true"></div>
	<div class="home-contact__content content" data-home-contact-content>
		<div class="home-contact__left left">
			<span class="home-contact__month month">Sep</span>
			<span class="home-contact__year year">'21</span>
		</div>
		<div class="home-contact__right right">
			<div class="home-contact__top top">
				<p>I'm available for freelance works.</p>
				<p>
					Say hello
					<a class="text" href={mailto}>{siteConfig.contact.email}</a>
				</p>
			</div>
			<div class="home-contact__bottom bottom">
				<a class="text" href="https://www.linkedin.com/in/juanmaperezvargas/" target="_blank" rel="noopener noreferrer">In</a>
				<i aria-hidden="true"> | </i>
				<a class="text" href="https://www.instagram.com/encapsulated.io/" target="_blank" rel="noopener noreferrer">Ig</a>
				<i aria-hidden="true"> | </i>
				<a class="text" href="https://twitter.com/juanmaperezvar" target="_blank" rel="noopener noreferrer">Tw</a>
				<i aria-hidden="true"> | </i>
				<a class="text" href="/blog">Blog</a>
			</div>
		</div>
	</div>
</section>

<style>
	.home-contact {
		width: 100%;
		max-width: 100%;
		height: 100vh;
		min-height: 100vh;
		background: #fbf9f3;
		position: relative;
		overflow: hidden;
		box-sizing: border-box;
		color: #fff;
	}
	.home-contact__cover {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		background: #b7c8cb;
		width: 100%;
		height: 100%;
	}
	.home-contact__content {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		display: flex;
		flex-direction: row;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
	}
	.home-contact__left,
	.home-contact__right {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}
	.home-contact__left {
		flex: 0.75;
		justify-content: center;
	}
	.home-contact__month,
	.home-contact__year {
		color: #fff;
		font-size: 400px;
		font-family: var(--font-heading);
		text-transform: uppercase;
		text-align: right;
		width: 100%;
		display: block;
		line-height: 0.85;
	}
	.home-contact__right {
		flex: 1.25;
		justify-content: center;
		padding: 50px;
		font-size: 32px;
		line-height: 1.4;
	}
	.home-contact__top {
		letter-spacing: 1px;
		padding: 20px 0;
		border-bottom: 3px solid #fff;
	}
	.home-contact__top p {
		margin: 0 0 0.5rem;
	}
	.home-contact__bottom {
		padding: 20px 0;
	}
	.home-contact__bottom i {
		opacity: 0.7;
		font-style: normal;
		padding: 0 10px;
	}
	.home-contact__bottom a {
		color: inherit;
	}
	.home-contact a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	@media (max-width: 1300px) {
		.home-contact__content {
			padding: 50px;
		}
		.home-contact__month,
		.home-contact__year {
			font-size: 320px;
		}
	}
	@media (max-width: 1024px) {
		.home-contact__content {
			flex-direction: column;
			justify-content: center;
			padding: 50px;
		}
		.home-contact__left {
			flex-direction: row;
			flex: 1;
			padding: 50px 0 0;
			justify-content: flex-start;
			align-items: flex-end;
		}
		.home-contact__month,
		.home-contact__year {
			text-align: left;
			width: min-content;
			display: inline;
		}
		.home-contact__right {
			flex: 1;
			padding: 20px 0;
			justify-content: flex-start;
		}
	}
	@media (max-width: 480px) {
		.home-contact__content {
			padding: 50px 20px;
		}
		.home-contact__left {
			padding: 50px 0 10px;
		}
		.home-contact__month,
		.home-contact__year {
			font-size: 100px;
		}
		.home-contact__right {
			padding: 0 0 30px;
			font-size: 20px;
		}
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
