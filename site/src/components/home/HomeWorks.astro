---
// site/src/components/home/HomeWorks.astro
import { getSortedProjects } from '../../utils/projectPosts';
import { resolveProjectAsset } from '../../utils/resolveProjectAsset';

const projects = await getSortedProjects();
---
<section class="home-works" aria-labelledby="home-works-heading">
	<h2 id="home-works-heading" class="home-works__title">projects</h2>
	<ul class="home-works__list">
		{projects.map((project) => {
			const thumbSrc = resolveProjectAsset(project.id, project.data.thumbnail);
			return (
				<li class="home-works__item">
					<a class="home-works__link" href={project.data.path}>
						{thumbSrc ? (
							<img
								src={thumbSrc}
								alt={project.data.title}
								width="400"
								height="300"
								loading="lazy"
							/>
						) : null}
						<span class="home-works__name">{project.data.title}</span>
					</a>
				</li>
			);
		})}
	</ul>
</section>

<style>
	.home-works {
		background: #fbf9f3;
		max-width: 100%;
		box-sizing: border-box;
		padding: 2rem 1rem;
		overflow: hidden;
	}
	.home-works__title {
		margin: 0 0 1.5rem;
		font-size: clamp(2rem, 12vw, 6rem);
		text-transform: uppercase;
		color: #b7c8cb;
		line-height: 1;
	}
	.home-works__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
		gap: 1.5rem;
		max-width: 100%;
		box-sizing: border-box;
	}
	.home-works__item {
		min-width: 0;
	}
	.home-works__link {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: #323846;
		text-decoration: none;
		max-width: 100%;
	}
	.home-works__link img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.home-works__name {
		font-weight: 700;
	}
	.home-works__link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
