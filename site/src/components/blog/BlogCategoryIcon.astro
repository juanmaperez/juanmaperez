---
interface Props {
	src: string;
	label: string;
}

const { src, label } = Astro.props;
---
<span
	class="blog-category-icon"
	role="img"
	aria-label={label}
	style={`background-image: url(${src})`}
></span>

<style>
	.blog-category-icon {
		display: inline-block;
		flex-shrink: 0;
		width: 10px;
		height: 17px;
		background-size: 130%;
		background-position: center 1px;
		background-repeat: no-repeat;
		border-radius: 50% / 25%;
		overflow: hidden;
		vertical-align: middle;
	}
</style>
