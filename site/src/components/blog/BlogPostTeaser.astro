---
import { getCategoryPath } from '../../utils/blogPosts';

interface Props {
	title: string;
	path: string;
	excerpt: string;
	date?: Date;
	category?: string;
	iconSrc?: string;
}

const { title, path, excerpt, date, category, iconSrc } = Astro.props;
---
<article class="blog-teaser post-wrapper">
	<h2 class="blog-teaser__title post-title">
		<a href={path}>{title}</a>
	</h2>
	{category && (
		<p class="blog-teaser__date post-date">
			{iconSrc && <img class="blog-teaser__icon post-icon" src={iconSrc} alt="" width="10" height="16" />}
			<a href={getCategoryPath(category)}>{category}</a>
			{date && (
				<>
					{' — '}
					<time datetime={date.toISOString()}>
						{date.toLocaleDateString('en-GB', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
				</>
			)}
		</p>
	)}
	<p class="blog-teaser__excerpt post-excerpt">{excerpt}</p>
</article>

<style>
	.blog-teaser {
		margin: 40px auto 20px;
		padding: 0 20px;
		box-sizing: border-box;
		width: 50%;
		max-width: 100%;
	}
	.blog-teaser__title {
		align-items: center;
		display: flex;
		margin: 20px 0;
		padding: 0;
		font-weight: 800;
		line-height: 1.2;
		font-size: 26px;
		color: var(--color-blog-accent, #fa991c);
		font-family: var(--font-blog-title);
	}
	.blog-teaser__title a {
		text-decoration: none;
		color: inherit;
	}
	.blog-teaser__date {
		align-items: center;
		display: flex;
		margin: 10px 0 0;
		font-size: 12px;
		color: var(--color-text);
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.blog-teaser__icon {
		margin-right: 5px;
		width: 8px;
		height: 16px;
		object-fit: cover;
	}
	.blog-teaser__excerpt {
		display: block;
		font-size: 15px;
		margin: 3px 0 0;
		line-height: 1.5;
		color: var(--color-text);
		font-weight: normal;
	}
	.blog-teaser a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	@media (max-width: 1590px) {
		.blog-teaser {
			width: 50%;
		}
	}
	@media (max-width: 1100px) {
		.blog-teaser {
			width: 55%;
		}
	}
	@media (max-width: 878px) {
		.blog-teaser {
			width: 65%;
		}
	}
	@media (max-width: 510px) {
		.blog-teaser {
			width: 98%;
			margin: 40px auto 0;
			padding: 10px;
		}
		.blog-teaser__title {
			font-size: 26px;
		}
	}
</style>
