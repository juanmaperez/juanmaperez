---
import { getCategoryPath } from '../../utils/blogPosts';
import BlogCategoryIcon from './BlogCategoryIcon.astro';

interface Props {
	title: string;
	path: string;
	excerpt: string;
	date?: Date;
	category?: string;
	iconSrc?: string;
}

const { title, path, excerpt, date, category, iconSrc } = Astro.props;
---
<article class="blog-teaser post-wrapper">
	<h2 class="blog-teaser__title post-title">
		<a href={path}>{title}</a>
	</h2>
	{category && (
		<p class="blog-teaser__date post-date">
			<a class="blog-teaser__category" href={getCategoryPath(category)}>
				{iconSrc && <BlogCategoryIcon src={iconSrc} label={category} />}
				{category}
			</a>
			{date && (
				<>
					{' — '}
					<time datetime={date.toISOString()}>
						{date.toLocaleDateString('en-GB', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
				</>
			)}
		</p>
	)}
	<p class="blog-teaser__excerpt post-excerpt">{excerpt}</p>
</article>

<style>
	.blog-teaser {
		margin: 40px auto 20px;
		padding: 0 20px;
		box-sizing: border-box;
		width: 50%;
		max-width: 100%;
	}
	.blog-teaser__title {
		align-items: center;
		display: flex;
		margin: 20px 0;
		padding: 0;
		font-weight: 800;
		line-height: 1.2;
		font-size: 26px;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text);
		font-family: var(--font-blog-title);
	}
	.blog-teaser__title a {
		text-decoration: none;
		color: inherit;
	}
	.blog-teaser__date {
		align-items: center;
		display: flex;
		margin: 10px 0 0;
		font-size: 12px;
		color: var(--color-text);
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.blog-teaser__category {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: inherit;
		text-decoration: none;
	}
	.blog-teaser__category:hover {
		text-decoration: underline;
	}
	.blog-teaser__excerpt {
		display: block;
		font-size: 15px;
		margin: 3px 0 0;
		line-height: 1.5;
		color: var(--color-text);
		font-weight: normal;
	}
	.blog-teaser a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	@media (max-width: 1590px) {
		.blog-teaser {
			width: 50%;
		}
	}
	@media (max-width: 1100px) {
		.blog-teaser {
			width: 55%;
		}
	}
	@media (max-width: 878px) {
		.blog-teaser {
			width: 65%;
		}
	}
	@media (max-width: 510px) {
		.blog-teaser {
			width: 98%;
			margin: 40px auto 0;
			padding: 10px;
		}
		.blog-teaser__title {
			font-size: 26px;
		}
	}
</style>
