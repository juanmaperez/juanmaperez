---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostNav from '../../components/blog/BlogPostNav.astro';
import {
	getSortedPosts,
	getBlogSlugFromPath,
	getAdjacentPosts,
	getCategoryPath,
} from '../../utils/blogPosts';
import { resolvePostIcon } from '../../utils/resolvePostIcon';
import BlogCategoryIcon from '../../components/blog/BlogCategoryIcon.astro';
import { render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: getBlogSlugFromPath(entry.data.path) },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const posts = await getSortedPosts();
const { prev, next } = getAdjacentPosts(posts, entry);
const { Content } = await render(entry);
const iconSrc = resolvePostIcon(entry.data.icon);
const formattedDate = entry.data.date.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---
<BlogLayout
	title={entry.data.title}
	description={entry.data.excerpt}
	canonicalPath={entry.data.path}
	ogType="article"
>
	<article class="blog-post">
		<header class="blog-post__header">
			<h1>{entry.data.title}</h1>
			<p class="blog-post__meta">
				<time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
				{entry.data.category && (
					<a class="blog-post__category" href={getCategoryPath(entry.data.category)}>
						{iconSrc && (
							<BlogCategoryIcon src={iconSrc} label={entry.data.category} />
						)}
						{entry.data.category}
					</a>
				)}
			</p>
		</header>
		<div class="blog-post__content">
			<Content />
		</div>
		<BlogPostNav prev={prev} next={next} />
	</article>
</BlogLayout>

<style>
	.blog-post {
		max-width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
		padding: 7.5rem 1rem 3rem;
		margin: 0 auto;
		color: #323846;
	}
	.blog-post__header {
		box-sizing: border-box;
		width: 50%;
		max-width: 670px;
		margin: 0 auto 2rem;
	}
	.blog-post__header h1 {
		margin: 0 0 1rem;
		font-family: var(--font-blog-title);
		font-size: 32px;
		font-weight: 800;
		line-height: 1.2;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-text);
	}
	.blog-post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin: 0;
		font-size: 0.8125rem;
		color: var(--color-text);
	}
	.blog-post__category {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-link);
		text-decoration: none;
	}
	.blog-post__category:hover {
		text-decoration: underline;
	}
	.blog-post__category:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	.blog-post__content {
		box-sizing: border-box;
		width: 50%;
		max-width: 670px;
		margin: 0 auto;
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	@media (max-width: 1100px) {
		.blog-post__header,
		.blog-post__content {
			width: 55%;
		}
	}
	@media (max-width: 878px) {
		.blog-post__header,
		.blog-post__content {
			width: 75%;
		}
	}
	@media (max-width: 510px) {
		.blog-post__header,
		.blog-post__content {
			width: 95%;
		}
		.blog-post__header h1 {
			font-size: 28px;
		}
	}
	.blog-post__content :global(h2),
	.blog-post__content :global(h3),
	.blog-post__content :global(h4) {
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}
	.blog-post__content :global(h2) {
		margin: 2rem 0 1rem;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		line-height: 1.3;
	}
	.blog-post__content :global(h3) {
		margin: 1.5rem 0 0.75rem;
		font-family: var(--font-heading);
		font-size: 1.25rem;
		line-height: 1.35;
	}
	.blog-post__content :global(h4) {
		margin: 1.25rem 0 0.5rem;
		font-family: var(--font-heading);
		font-size: 1.125rem;
		line-height: 1.35;
	}
	.blog-post__content :global(p) {
		margin: 0 0 1rem;
	}
	.blog-post__content :global(ul),
	.blog-post__content :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.5rem;
	}
	.blog-post__content :global(blockquote) {
		margin: 1rem 0;
		padding-left: 1rem;
		border-left: 3px solid #b7c8cb;
	}
	.blog-post__content :global(table) {
		width: 100%;
		margin: 0 0 1.25rem;
		border-collapse: collapse;
		font-size: 0.9375rem;
		line-height: 1.5;
	}
	.blog-post__content :global(thead th) {
		font-family: var(--font-heading);
		font-weight: normal;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: 0.8125rem;
		background: #f0ede6;
	}
	.blog-post__content :global(th),
	.blog-post__content :global(td) {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-accent);
		text-align: left;
		vertical-align: top;
	}
	.blog-post__content :global(tbody tr:nth-child(even) td) {
		background: rgba(183, 200, 203, 0.12);
	}
	.blog-post__content :global(pre.astro-code) {
		overflow-x: auto;
		max-width: 100%;
		padding: 1rem;
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.blog-post__content :global(:not(pre) > code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: #f0ede6;
		padding: 0.1em 0.35em;
		border-radius: 3px;
	}
	.blog-post__content :global(img) {
		max-width: 100%;
		height: auto;
	}
	.blog-post__content :global(a:focus-visible) {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
