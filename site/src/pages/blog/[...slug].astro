---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostNav from '../../components/blog/BlogPostNav.astro';
import {
	getSortedPosts,
	getBlogSlugFromPath,
	getAdjacentPosts,
	getCategoryPath,
} from '../../utils/blogPosts';
import { resolvePostIcon } from '../../utils/resolvePostIcon';
import { render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: getBlogSlugFromPath(entry.data.path) },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const posts = await getSortedPosts();
const { prev, next } = getAdjacentPosts(posts, entry);
const { Content } = await render(entry);
const iconSrc = resolvePostIcon(entry.data.icon);
const formattedDate = entry.data.date.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---
<BlogLayout title={entry.data.title} description={entry.data.excerpt}>
	<article class="blog-post">
		<h1>{entry.data.title}</h1>
		<p class="blog-post__meta">
			<time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
			{entry.data.category && (
				<span class="blog-post__category">
					{iconSrc && (
						<img
							class="blog-post__icon"
							src={iconSrc}
							alt=""
							width="16"
							height="16"
						/>
					)}
					<a href={getCategoryPath(entry.data.category)}>{entry.data.category}</a>
				</span>
			)}
		</p>
		<div class="blog-post__content">
			<Content />
		</div>
		<BlogPostNav prev={prev} next={next} />
	</article>
</BlogLayout>

<style>
	.blog-post {
		max-width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
		padding: 7.5rem 1rem 3rem;
		margin: 0 auto;
		color: #323846;
	}
	.blog-post h1 {
		margin: 0 0 1rem;
		font-size: 2rem;
		line-height: 1.2;
	}
	.blog-post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin: 0 0 2rem;
		font-size: 0.875rem;
		color: #5a6578;
	}
	.blog-post__category {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.blog-post__category a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	.blog-post__content {
		max-width: 670px;
		margin: 0 auto;
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	.blog-post__content :global(h2) {
		margin: 2rem 0 1rem;
		font-size: 1.5rem;
		line-height: 1.3;
	}
	.blog-post__content :global(h3) {
		margin: 1.5rem 0 0.75rem;
		font-size: 1.25rem;
		line-height: 1.35;
	}
	.blog-post__content :global(p) {
		margin: 0 0 1rem;
	}
	.blog-post__content :global(ul),
	.blog-post__content :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.5rem;
	}
	.blog-post__content :global(blockquote) {
		margin: 1rem 0;
		padding-left: 1rem;
		border-left: 3px solid #b7c8cb;
	}
	.blog-post__content :global(pre.astro-code) {
		overflow-x: auto;
		max-width: 100%;
		padding: 1rem;
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.blog-post__content :global(:not(pre) > code) {
		font-family: ui-monospace, monospace;
		font-size: 0.9em;
		background: #f0ede6;
		padding: 0.1em 0.35em;
		border-radius: 3px;
	}
	.blog-post__content :global(img) {
		max-width: 100%;
		height: auto;
	}
	.blog-post__content :global(a:focus-visible) {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
</style>
